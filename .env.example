# PostgreSQL Settings
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_memory_db
POSTGRES_PORT=5434

# OpenAI-Compatible API Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4o-mini

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL_NAME=text-embedding-3-small
# Must match halfvec(1536) in postgres/init.sql. Change both if using a different model.
EMBEDDING_DIM=1536

# Memory Engine API Service (inter-container URL, not the host port)
MEMORY_ENGINE_URL=http://memory-engine:8000
